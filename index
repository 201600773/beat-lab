<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Beat Lab — Step Drum Machine</title>
<style>
  * { box-sizing: border-box; }

  :root {
    --bg: #080a0f;
    --panel: #11141c;
    --panel-2: #1a1f2b;
    --panel-3: #232a39;
    --line: #232936;
    --line-2: #313a4d;
    --text: #e7ecf5;
    --muted: #6b768c;
  }

  html, body { height: 100%; }

  body {
    margin: 0;
    padding: 24px 16px 64px;
    background: radial-gradient(1200px 640px at 50% -14%, #17222f 0%, #080a0f 62%) fixed;
    color: var(--text);
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .app { max-width: 1220px; margin: 0 auto; }

  /* ---------- Header ---------- */
  header {
    display: flex; flex-wrap: wrap; gap: 16px;
    align-items: center; justify-content: space-between;
    margin-bottom: 18px;
  }
  .brand { display: flex; align-items: center; gap: 13px; }
  .logo {
    width: 44px; height: 44px; border-radius: 13px;
    display: grid; place-items: center;
    font-size: 19px; color: #14060a;
    background: linear-gradient(135deg, #ff5c7a, #b48dff);
    box-shadow: 0 10px 28px rgba(180, 141, 255, .35);
  }
  h1 { font-size: 18px; margin: 0; letter-spacing: .17em; font-weight: 800; }
  .brand p { margin: 3px 0 0; font-size: 11px; color: var(--muted); letter-spacing: .04em; }

  .transport { display: flex; flex-wrap: wrap; gap: 9px; align-items: center; }

  /* ---------- Buttons ---------- */
  .btn {
    background: var(--panel-2);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 9px 14px;
    font: inherit; font-size: 13px; font-weight: 650;
    cursor: pointer; white-space: nowrap;
    transition: background .15s, border-color .15s, transform .08s, opacity .15s;
  }
  .btn:hover:not(:disabled) { background: var(--panel-3); border-color: var(--line-2); }
  .btn:active:not(:disabled) { transform: scale(.97); }
  .btn:disabled { opacity: .35; cursor: default; }
  .btn.play {
    border: none; min-width: 104px;
    background: linear-gradient(135deg, #ff5c7a, #ff8a5c);
    color: #170609;
    box-shadow: 0 8px 22px rgba(255, 92, 122, .3);
  }
  .btn.play.active {
    background: linear-gradient(135deg, #4dffb8, #4dd4ff);
    color: #04120d;
    box-shadow: 0 8px 22px rgba(77, 255, 184, .3);
  }
  .btn.danger:hover:not(:disabled) { background: #3a1a22; border-color: #6b2733; }

  .select {
    background: var(--panel-2);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 9px 30px 9px 14px;
    font: inherit; font-size: 13px; font-weight: 650;
    cursor: pointer; max-width: 190px;
    transition: background .15s, border-color .15s;
  }
  .select:hover { background: var(--panel-3); border-color: var(--line-2); }

  .seg {
    display: inline-flex; gap: 2px; padding: 3px;
    background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px;
  }
  .seg button {
    background: transparent; border: 0; color: var(--muted);
    font: inherit; font-size: 12px; font-weight: 750;
    padding: 6px 11px; border-radius: 7px; cursor: pointer;
    transition: background .15s, color .15s;
  }
  .seg button:hover { color: var(--text); }
  .seg button.active { background: var(--panel-3); color: var(--text); }

  /* ---------- Controls ---------- */
  .controls {
    display: flex; flex-wrap: wrap; gap: 24px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 15px 20px;
    margin-bottom: 14px;
  }
  .ctrl { display: flex; flex-direction: column; gap: 8px; flex: 1 1 150px; min-width: 130px; }
  .ctrl span {
    font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--muted); font-weight: 750;
  }
  .ctrl b { color: var(--text); font-weight: 750; }

  input[type=range] {
    -webkit-appearance: none; appearance: none;
    width: 100%; height: 4px; border-radius: 3px;
    background: #2a3242; outline: none; cursor: pointer;
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px; height: 16px; border-radius: 50%;
    background: #e7ecf5; cursor: pointer;
    box-shadow: 0 0 0 4px rgba(231, 236, 245, .1);
    transition: box-shadow .15s;
  }
  input[type=range]::-webkit-slider-thumb:hover { box-shadow: 0 0 0 6px rgba(231, 236, 245, .16); }
  input[type=range]::-moz-range-thumb {
    width: 16px; height: 16px; border: none; border-radius: 50%;
    background: #e7ecf5; cursor: pointer;
  }

  /* ---------- Toolbar ---------- */
  .toolbar {
    display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
    margin-bottom: 16px;
  }
  .sep { width: 1px; height: 22px; background: var(--line); margin: 0 4px; }

  /* ---------- Grid ---------- */
  .grid { overflow-x: auto; padding-bottom: 12px; user-select: none; }
  .tracks { min-width: 100%; }

  .track {
    display: grid;
    grid-template-columns: 152px 1fr;
    gap: 12px;
    align-items: center;
    margin-bottom: 7px;
  }

  .track-side { display: flex; align-items: stretch; gap: 4px; min-width: 0; }

  .solo-btn {
    flex: none; width: 23px; padding: 0;
    border-radius: 7px; border: 1px solid var(--line);
    background: var(--panel-2); color: var(--muted);
    font: inherit; font-size: 10px; font-weight: 800;
    cursor: pointer;
    transition: background .15s, color .15s, border-color .15s;
  }
  .solo-btn:hover { color: var(--text); border-color: var(--line-2); }
  .track.soloed .solo-btn { background: #ffd93d; border-color: #ffd93d; color: #191200; }

  .name-btn {
    flex: 1; min-width: 0;
    display: flex; align-items: center; gap: 8px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px 9px;
    color: var(--text); font: inherit; font-size: 12.5px; font-weight: 650;
    cursor: pointer; text-align: left;
    transition: background .15s, opacity .15s;
  }
  .name-btn:hover { background: var(--panel-2); }
  .name-btn .dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--c); box-shadow: 0 0 10px var(--c);
    flex: none;
  }
  .name-btn .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .track.muted .name-btn { opacity: .35; }
  .track.muted .name-btn .name { text-decoration: line-through; }
  .track.muted .steps { opacity: .38; }

  .steps { display: grid; gap: 5px; }

  .step {
    height: 42px; padding: 0;
    border-radius: 7px;
    border: 1px solid var(--line);
    background: var(--panel-2);
    cursor: pointer;
    transition: background .1s, box-shadow .12s, transform .06s, border-color .12s;
  }
  .step.beat { background: #1c2230; }
  .step:hover { border-color: var(--line-2); }
  .step:active { transform: scale(.94); }
  .step.on {
    background: var(--c);
    border-color: var(--c);
    box-shadow: 0 0 14px -3px var(--c);
  }
  .step.accent {
    background: color-mix(in srgb, var(--c) 76%, #fff);
    border-color: color-mix(in srgb, var(--c) 55%, #fff);
    box-shadow: inset 0 0 0 2px rgba(255,255,255,.5), 0 0 18px -1px var(--c);
  }
  .step.playing { outline: 2px solid rgba(255,255,255,.55); outline-offset: -2px; }

  footer {
    margin-top: 26px; text-align: center;
    font-size: 11.5px; color: var(--muted); letter-spacing: .03em; line-height: 2;
  }
  kbd {
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 5px;
    padding: 1px 6px;
    font: inherit; font-size: 11px;
  }

  @media (max-width: 760px) {
    body { padding: 16px 11px 50px; }
    .track { grid-template-columns: 100px 1fr; gap: 8px; }
    .name-btn { font-size: 11px; padding: 7px 6px; gap: 6px; }
    .solo-btn { width: 19px; }
    .step { height: 34px; border-radius: 6px; }
    .steps { gap: 4px; }
    .controls { gap: 15px; padding: 13px; }
    .select { max-width: 150px; }
  }
</style>
</head>
<body>

<div class="app">
  <header>
    <div class="brand">
      <div class="logo">◉</div>
      <div>
        <h1>BEAT LAB</h1>
        <p>step drum machine · pure Web Audio</p>
      </div>
    </div>

    <div class="transport">
      <button id="playBtn" class="btn play" type="button">▶ Play</button>
      <button id="tapBtn" class="btn" type="button" title="Tap 4× to set tempo">Tap</button>
      <div class="seg" id="lengthSeg" title="Pattern length">
        <button type="button" data-len="8">8</button>
        <button type="button" data-len="16" class="active">16</button>
        <button type="button" data-len="32">32</button>
      </div>
    </div>
  </header>

  <section class="controls">
    <label class="ctrl">
      <span>Tempo · <b id="bpmVal">96</b> BPM</span>
      <input type="range" id="bpm" min="60" max="190" value="96">
    </label>
    <label class="ctrl">
      <span>Swing · <b id="swingVal">0</b>%</span>
      <input type="range" id="swing" min="0" max="80" value="0">
    </label>
    <label class="ctrl">
      <span>Volume · <b id="volVal">75</b>%</span>
      <input type="range" id="vol" min="0" max="100" value="75">
    </label>
  </section>

  <section class="toolbar">
    <select id="presetSel" class="select" title="Load a preset"></select>
    <button id="randBtn" class="btn" type="button">Random</button>
    <button id="clearBtn" class="btn" type="button">Clear</button>
    <button id="undoBtn" class="btn" type="button" disabled>Undo</button>
    <span class="sep"></span>
    <button id="saveBtn" class="btn" type="button">Save…</button>
    <select id="slotSel" class="select" title="Load a saved pattern"></select>
    <button id="delBtn" class="btn danger" type="button">Delete</button>
    <span class="sep"></span>
    <button id="exportBtn" class="btn" type="button">Export</button>
    <button id="importBtn" class="btn" type="button">Import</button>
    <input type="file" id="importInput" accept="application/json,.json" hidden>
  </section>

  <main class="grid">
    <div class="tracks" id="tracks"></div>
  </main>

  <footer>
    Click a pad to cycle <b>off → hit → accent</b> · click a track name to mute ·
    <b>S</b> to solo · <b>right-click</b> a name to clear that track ·
    <kbd>Space</kbd> play/stop · <kbd>1</kbd>–<kbd>8</kbd> mute · <kbd>Shift</kbd>+<kbd>1</kbd>–<kbd>8</kbd> solo · <kbd>R</kbd> random
  </footer>
</div>

<script>
/* ============================================================
   CONSTANTS & STATE
   ============================================================ */
const NUM_MAX = 32;               // internal pattern capacity
const VEL = [0, 0.6, 1.0];        // off / normal / accent

const state = {
  playing: false,
  bpm: 96,
  swing: 0,          // 0 … 0.8
  volume: 0.75,
  length: 16,        // 8 | 16 | 32
  step: 0,
  nextTime: 0,
  timer: null,
};

const pattern = {};   // id -> Array(NUM_MAX) of 0|1|2
const muted  = new Set();
const soloed = new Set();

const $ = (id) => document.getElementById(id);
const clamp = (v, a, b) => Math.min(b, Math.max(a, v));

/* ============================================================
   AUDIO ENGINE
   ============================================================ */
let actx = null;
let master = null;
let reverbSend = null;
let reverbReturn = null;
let noiseBuf = null;
let openHats = [];

function makeImpulse(seconds, decay) {
  const rate = actx.sampleRate;
  const len = Math.floor(rate * seconds);
  const buf = actx.createBuffer(2, len, rate);
  for (let ch = 0; ch < 2; ch++) {
    const d = buf.getChannelData(ch);
    for (let i = 0; i < len; i++) {
      d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, decay);
    }
  }
  return buf;
}

function initAudio() {
  if (actx) return;
  const AC = window.AudioContext || window.webkitAudioContext;
  actx = new AC();

  master = actx.createGain();
  master.gain.value = state.volume;

  const comp = actx.createDynamicsCompressor();
  comp.threshold.value = -9;
  comp.knee.value = 18;
  comp.ratio.value = 5;
  comp.attack.value = 0.004;
  comp.release.value = 0.22;

  master.connect(comp);
  comp.connect(actx.destination);

  // Shared reverb send
  const conv = actx.createConvolver();
  conv.buffer = makeImpulse(1.3, 2.6);
  reverbReturn = actx.createGain();
  reverbReturn.gain.value = 0.45;
  reverbSend = actx.createGain();
  reverbSend.gain.value = 1;
  reverbSend.connect(conv);
  conv.connect(reverbReturn);
  reverbReturn.connect(master);

  // Shared noise buffer
  const len = Math.floor(actx.sampleRate * 1.0);
  noiseBuf = actx.createBuffer(1, len, actx.sampleRate);
  const d = noiseBuf.getChannelData(0);
  for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
}

function ensureAudio() {
  initAudio();
  if (actx.state === 'suspended') actx.resume().catch(() => {});
}

/* Route a voice output to master (+ optional reverb send), with cleanup. */
function out(node, send) {
  node.connect(master);
  let sg = null;
  if (send) {
    sg = actx.createGain();
    sg.gain.value = send;
    node.connect(sg);
    sg.connect(reverbSend);
  }
  // Detach after the voice has fully decayed so the graph doesn't grow.
  setTimeout(() => {
    try { node.disconnect(); } catch (e) {}
    if (sg) { try { sg.disconnect(); } catch (e) {} }
  }, 5000);
}

/* ---------- Kick ---------- */
function kick(t, v) {
  const o = actx.createOscillator();
  const g = actx.createGain();
  o.type = 'sine';
  o.frequency.setValueAtTime(160, t);
  o.frequency.exponentialRampToValueAtTime(44, t + 0.09);
  g.gain.setValueAtTime(0.0001, t);
  g.gain.exponentialRampToValueAtTime(1.05 * v, t + 0.004);
  g.gain.exponentialRampToValueAtTime(0.0001, t + 0.42);
  o.connect(g);
  out(g, 0.04);
  o.start(t); o.stop(t + 0.45);

  // Beater click
  const c = actx.createOscillator();
  const cg = actx.createGain();
  c.type = 'triangle';
  c.frequency.setValueAtTime(1050, t);
  cg.gain.setValueAtTime(0.25 * v, t);
  cg.gain.exponentialRampToValueAtTime(0.0001, t + 0.025);
  c.connect(cg);
  out(cg, 0);
  c.start(t); c.stop(t + 0.03);
}

/* ---------- Snare ---------- */
function snare(t, v) {
  const src = actx.createBufferSource();
  src.buffer = noiseBuf;
  const hp = actx.createBiquadFilter();
  hp.type = 'highpass'; hp.frequency.value = 1100;
  const bp = actx.createBiquadFilter();
  bp.type = 'bandpass'; bp.frequency.value = 2700; bp.Q.value = 0.7;
  const g = actx.createGain();
  g.gain.setValueAtTime(0.0001, t);
  g.gain.exponentialRampToValueAtTime(0.75 * v, t + 0.002);
  g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
  src.connect(hp); hp.connect(bp); bp.connect(g);
  out(g, 0.16);
  src.start(t, Math.random() * 0.6);
  src.stop(t + 0.21);

  const o = actx.createOscillator();
  const og = actx.createGain();
  o.type = 'triangle';
  o.frequency.setValueAtTime(195, t);
  o.frequency.exponentialRampToValueAtTime(125, t + 0.08);
  og.gain.setValueAtTime(0.45 * v, t);
  og.gain.exponentialRampToValueAtTime(0.0001, t + 0.12);
  o.connect(og);
  out(og, 0.1);
  o.start(t); o.stop(t + 0.14);
}

/* ---------- Clap ---------- */
function clap(t, v) {
  const offs = [0, 0.01, 0.021, 0.034];
  offs.forEach((off, i) => {
    const last = i === offs.length - 1;
    const src = actx.createBufferSource();
    src.buffer = noiseBuf;
    const bp = actx.createBiquadFilter();
    bp.type = 'bandpass'; bp.frequency.value = 1350; bp.Q.value = 1.1;
    const g = actx.createGain();
    g.gain.setValueAtTime((last ? 0.55 : 0.3) * v, t + off);
    g.gain.exponentialRampToValueAtTime(0.0001, t + off + (last ? 0.19 : 0.03));
    src.connect(bp); bp.connect(g);
    out(g, 0.2);
    src.start(t + off, Math.random() * 0.5);
    src.stop(t + off + 0.22);
  });
}

/* ---------- Hats (closed chokes open) ---------- */
function hat(t, v, open) {
  if (!open) {
    openHats.forEach((g) => {
      try {
        g.gain.cancelScheduledValues(t);
        g.gain.setTargetAtTime(0.0001, t, 0.006);
      } catch (e) {}
    });
    openHats = [];
  }

  const src = actx.createBufferSource();
  src.buffer = noiseBuf;
  const hp = actx.createBiquadFilter();
  hp.type = 'highpass'; hp.frequency.value = 7500;
  const bp = actx.createBiquadFilter();
  bp.type = 'bandpass';
  bp.frequency.value = open ? 9000 : 11000;
  bp.Q.value = 1.0;

  const g = actx.createGain();
  const dur = open ? 0.34 : 0.05;
  g.gain.setValueAtTime(0.0001, t);
  g.gain.exponentialRampToValueAtTime((open ? 0.32 : 0.4) * v, t + 0.002);
  g.gain.exponentialRampToValueAtTime(0.0001, t + dur);

  src.connect(hp); hp.connect(bp); bp.connect(g);
  out(g, open ? 0.07 : 0.03);
  src.start(t, Math.random() * 0.6);
  src.stop(t + dur + 0.03);

  if (open) {
    openHats.push(g);
    if (openHats.length > 8) openHats.shift();
  }
}

/* ---------- Tom ---------- */
function tom(t, v) {
  const o = actx.createOscillator();
  const g = actx.createGain();
  o.type = 'sine';
  o.frequency.setValueAtTime(240, t);
  o.frequency.exponentialRampToValueAtTime(95, t + 0.22);
  g.gain.setValueAtTime(0.0001, t);
  g.gain.exponentialRampToValueAtTime(0.7 * v, t + 0.005);
  g.gain.exponentialRampToValueAtTime(0.0001, t + 0.3);
  o.connect(g);
  out(g, 0.14);
  o.start(t); o.stop(t + 0.33);
}

/* ---------- Rim ---------- */
function rim(t, v) {
  const o = actx.createOscillator();
  const bp = actx.createBiquadFilter();
  const g = actx.createGain();
  o.type = 'square';
  o.frequency.setValueAtTime(1750, t);
  bp.type = 'bandpass'; bp.frequency.value = 2150; bp.Q.value = 4;
  g.gain.setValueAtTime(0.0001, t);
  g.gain.exponentialRampToValueAtTime(0.22 * v, t + 0.001);
  g.gain.exponentialRampToValueAtTime(0.0001, t + 0.035);
  o.connect(bp); bp.connect(g);
  out(g, 0.12);
  o.start(t); o.stop(t + 0.05);
}

/* ---------- Cowbell ---------- */
function cowbell(t, v) {
  const bp = actx.createBiquadFilter();
  bp.type = 'bandpass'; bp.frequency.value = 840; bp.Q.value = 1.4;
  const g = actx.createGain();
  g.gain.setValueAtTime(0.0001, t);
  g.gain.exponentialRampToValueAtTime(0.28 * v, t + 0.003);
  g.gain.exponentialRampToValueAtTime(0.0001, t + 0.3);
  bp.connect(g);
  out(g, 0.14);
  [590, 850].forEach((f) => {
    const o = actx.createOscillator();
    o.type = 'square';
    o.frequency.value = f;
    o.connect(bp);
    o.start(t); o.stop(t + 0.32);
  });
}

/* ============================================================
   TRACKS
   ============================================================ */
const TRACKS = [
  { id: 'kick',    name: 'Kick',     color: '#ff5c7a', trigger: (t, v) => kick(t, v) },
  { id: 'snare',   name: 'Snare',    color: '#ffa14d', trigger: (t, v) => snare(t, v) },
  { id: 'clap',    name: 'Clap',     color: '#ffd93d', trigger: (t, v) => clap(t, v) },
  { id: 'hat',     name: 'Hat',      color: '#4dd4ff', trigger: (t, v) => hat(t, v, false) },
  { id: 'openhat', name: 'Open Hat', color: '#4dffb8', trigger: (t, v) => hat(t, v, true) },
  { id: 'tom',     name: 'Tom',      color: '#b48dff', trigger: (t, v) => tom(t, v) },
  { id: 'rim',     name: 'Rim',      color: '#ff8ad4', trigger: (t, v) => rim(t, v) },
  { id: 'cowbell', name: 'Cowbell',  color: '#9dff4d', trigger: (t, v) => cowbell(t, v) },
];

TRACKS.forEach((t) => { pattern[t.id] = new Array(NUM_MAX).fill(0); });

/* ============================================================
   PRESETS   ('X' = accent, 'x' = hit, '.' = off)
   ============================================================ */
const PRESETS = {
  'Boom Bap': {
    bpm: 90,
    kick:    'X......X..X.....',
    snare:   '....X.......X...',
    hat:     'x.x.x.x.x.x.x.x.',
    openhat: '................',
    clap:    '................',
    tom:     '................',
    rim:     '................',
    cowbell: '................',
  },
  'House': {
    bpm: 124,
    kick:    'X...X...X...X...',
    snare:   '................',
    clap:    '....X.......X...',
    hat:     'X.x.X.x.X.x.X.x.',
    openhat: '..X...X...X...X.',
    tom:     '................',
    rim:     '................',
    cowbell: '................',
  },
  'Trap': {
    bpm: 140,
    kick:    'X.....X...X.....',
    snare:   '....X.......X...',
    clap:    '................',
    hat:     'x.XXx.x.xx.x.XXx',
    openhat: '................',
    tom:     '................',
    rim:     '................',
    cowbell: '................',
  },
  'Breakbeat': {
    bpm: 168,
    kick:    'X.....X...X.....',
    snare:   '....X..X.X..X...',
    clap:    '................',
    hat:     'x.xxx.x.x.xxx.x.',
    openhat: '................',
    tom:     '..............X.',
    rim:     '................',
    cowbell: '................',
  },
  'Techno': {
    bpm: 132,
    kick:    'X...X...X...X...',
    snare:   '................',
    clap:    '....X.......X...',
    hat:     '..x...x...x...x.',
    openhat: '................',
    tom:     '................',
    rim:     '...........X....',
    cowbell: '................',
  },
  'Lo-Fi': {
    bpm: 78,
    kick:    'X.......X.X.....',
    snare:   '....X.......X...',
    hat:     'x.x.x.x.x.x.x.x.',
    openhat: '................',
    clap:    '................',
    tom:     '................',
    rim:     '................',
    cowbell: '................',
  },
  'Empty': {
    bpm: 96,
    kick: '................', snare: '................', clap: '................',
    hat: '................', openhat: '................', tom: '................',
    rim: '................', cowbell: '................',
  },
};

/* ============================================================
   DOM REFS
   ============================================================ */
const tracksEl   = $('tracks');
const playBtn    = $('playBtn');
const tapBtn     = $('tapBtn');
const presetSel  = $('presetSel');
const slotSel    = $('slotSel');
const randBtn    = $('randBtn');
const clearBtn   = $('clearBtn');
const undoBtn    = $('undoBtn');
const saveBtn    = $('saveBtn');
const delBtn     = $('delBtn');
const exportBtn  = $('exportBtn');
const importBtn  = $('importBtn');
const importInput= $('importInput');

const bpmInput   = $('bpm');
const bpmVal     = $('bpmVal');
const swingInput = $('swing');
const swingVal   = $('swingVal');
const volInput   = $('vol');
const volVal     = $('volVal');

/* ============================================================
   GRID
   ============================================================ */
let cells = [];        // cells[trackIndex][stepIndex] -> button
let playheadCol = -1;

function buildGrid() {
  tracksEl.innerHTML = '';
  cells = [];
  playheadCol = -1;

  TRACKS.forEach((track, ti) => {
    const row = document.createElement('div');
    row.className = 'track';
    row.style.setProperty('--c', track.color);

    const side = document.createElement('div');
    side.className = 'track-side';

    const soloBtn = document.createElement('button');
    soloBtn.type = 'button';
    soloBtn.className = 'solo-btn';
    soloBtn.textContent = 'S';
    soloBtn.title = `Solo ${track.name} (Shift+${ti + 1})`;
    soloBtn.addEventListener('click', () => toggleSolo(track.id));

    const nameBtn = document.createElement('button');
    nameBtn.type = 'button';
    nameBtn.className = 'name-btn';
    nameBtn.title = `Mute ${track.name} · right-click to clear`;
    const dot = document.createElement('span');
    dot.className = 'dot';
    const nm = document.createElement('span');
    nm.className = 'name';
    nm.textContent = track.name;
    nameBtn.append(dot, nm);
    nameBtn.addEventListener('click', () => toggleMute(track.id));
    nameBtn.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      clearTrack(track.id);
    });

    side.append(soloBtn, nameBtn);

    const stepsEl = document.createElement('div');
    stepsEl.className = 'steps';
    stepsEl.style.gridTemplateColumns = `repeat(${state.length}, minmax(20px, 1fr))`;

    const rowCells = [];
    for (let i = 0; i < state.length; i++) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'step' + (i % 4 === 0 ? ' beat' : '');
      b.addEventListener('click', () => toggleCell(ti, i));
      stepsEl.appendChild(b);
      rowCells.push(b);
    }

    row.append(side, stepsEl);
    tracksEl.appendChild(row);
    cells.push(rowCells);
  });

  paintAll();
}

function paintCell(ti, si) {
  const el = cells[ti] && cells[ti][si];
  if (!el) return;
  const v = pattern[TRACKS[ti].id][si] || 0;
  el.classList.toggle('on', v > 0);
  el.classList.toggle('accent', v === 2);
}

function paintRow(ti) {
  const row = tracksEl.children[ti];
  if (!row) return;
  const id = TRACKS[ti].id;
  row.classList.toggle('muted', muted.has(id));
  row.classList.toggle('soloed', soloed.has(id));
}

function paintAll() {
  TRACKS.forEach((_, ti) => {
    for (let i = 0; i < state.length; i++) paintCell(ti, i);
    paintRow(ti);
  });
}

/* ============================================================
   CELL / TRACK INTERACTIONS
   ============================================================ */
function toggleCell(ti, si) {
  ensureAudio();
  const id = TRACKS[ti].id;
  pattern[id][si] = (pattern[id][si] + 1) % 3;
  paintCell(ti, si);
  const v = pattern[id][si];
  if (v && actx) TRACKS[ti].trigger(actx.currentTime + 0.01, VEL[v]);
  scheduleSave();
}

function toggleMute(id) {
  if (muted.has(id)) muted.delete(id); else muted.add(id);
  paintRow(TRACKS.findIndex((t) => t.id === id));
  scheduleSave();
}

function toggleSolo(id) {
  if (soloed.has(id)) soloed.delete(id); else soloed.add(id);
  paintRow(TRACKS.findIndex((t) => t.id === id));
  scheduleSave();
}

function clearTrack(id) {
  pushUndo();
  pattern[id].fill(0);
  const ti = TRACKS.findIndex((t) => t.id === id);
  for (let i = 0; i < state.length; i++) paintCell(ti, i);
  scheduleSave();
}

function isSilent(id) {
  if (muted.has(id)) return true;
  if (soloed.size > 0 && !soloed.has(id)) return true;
  return false;
}

/* ============================================================
   TRANSPORT & SCHEDULER
   ============================================================ */
const LOOKAHEAD_MS = 25;
const SCHEDULE_AHEAD = 0.12;
const queue = [];

function scheduler() {
  const secPerStep = 60 / state.bpm / 4;
  while (state.nextTime < actx.currentTime + SCHEDULE_AHEAD) {
    const step = state.step;
    let time = state.nextTime;
    if (step % 2 === 1) time += state.swing * secPerStep * 0.5;

    playStep(step, time);
    queue.push({ step, time });

    state.nextTime += secPerStep;
    state.step = (state.step + 1) % state.length;
  }
}

function playStep(step, time) {
  for (const track of TRACKS) {
    if (isSilent(track.id)) continue;
    const v = pattern[track.id][step];
    if (v) track.trigger(time, VEL[v]);
  }
}

async function start() {
  ensureAudio();
  if (actx.state === 'suspended') await actx.resume();

  state.playing = true;
  state.step = 0;
  state.nextTime = actx.currentTime + 0.08;
  queue.length = 0;

  scheduler();
  state.timer = setInterval(scheduler, LOOKAHEAD_MS);

  playBtn.textContent = '■ Stop';
  playBtn.classList.add('active');
}

function stop() {
  state.playing = false;
  clearInterval(state.timer);
  state.timer = null;
  queue.length = 0;

  setPlayhead(-1);
  playBtn.textContent = '▶ Play';
  playBtn.classList.remove('active');
}

function toggleTransport() { state.playing ? stop() : start(); }

playBtn.addEventListener('click', toggleTransport);

/* ---------- Playhead ---------- */
function setPlayhead(step) {
  if (playheadCol >= 0) {
    for (const row of cells) {
      const c = row[playheadCol];
      if (c) c.classList.remove('playing');
    }
  }
  if (step >= 0) {
    for (const row of cells) {
      const c = row[step];
      if (c) c.classList.add('playing');
    }
  }
  playheadCol = step;
}

function frame() {
  requestAnimationFrame(frame);
  if (!actx || !state.playing) return;

  const now = actx.currentTime;
  let target = playheadCol;
  while (queue.length && queue[0].time <= now) {
    target = queue.shift().step;
  }
  if (target !== playheadCol) setPlayhead(target);
}
requestAnimationFrame(frame);

/* ============================================================
   CONTROLS
   ============================================================ */
function setBpm(v) {
  state.bpm = clamp(Math.round(v), 60, 190);
  bpmInput.value = state.bpm;
  bpmVal.textContent = state.bpm;
}

bpmInput.addEventListener('input', () => {
  setBpm(+bpmInput.value);
  scheduleSave();
});

swingInput.addEventListener('input', () => {
  state.swing = +swingInput.value / 100;
  swingVal.textContent = swingInput.value;
  scheduleSave();
});

volInput.addEventListener('input', () => {
  state.volume = +volInput.value / 100;
  volVal.textContent = volInput.value;
  if (actx && master) {
    master.gain.setTargetAtTime(state.volume, actx.currentTime, 0.01);
  }
  scheduleSave();
});

/* ---------- Length ---------- */
document.querySelectorAll('#lengthSeg button').forEach((btn) => {
  btn.addEventListener('click', () => setLength(+btn.dataset.len));
});

function setLength(n) {
  state.length = n;
  if (state.step >= n) state.step = 0;
  document.querySelectorAll('#lengthSeg button').forEach((b) => {
    b.classList.toggle('active', +b.dataset.len === n);
  });
  buildGrid();
  scheduleSave();
}

/* ---------- Tap tempo ---------- */
let taps = [];
tapBtn.addEventListener('click', () => {
  const now = performance.now();
  taps = taps.filter((t) => now - t < 2000);
  taps.push(now);
  if (taps.length >= 2) {
    const gaps = [];
    for (let i = 1; i < taps.length; i++) gaps.push(taps[i] - taps[i - 1]);
    const avg = gaps.reduce((a, b) => a + b, 0) / gaps.length;
    setBpm(Math.round(60000 / avg));
    scheduleSave();
  }
});

/* ============================================================
   PRESETS / RANDOM / CLEAR
   ============================================================ */
presetSel.innerHTML = '<option value="">— Preset —</option>';
Object.keys(PRESETS).forEach((name) => {
  const o = document.createElement('option');
  o.value = name;
  o.textContent = name;
  presetSel.appendChild(o);
});

presetSel.addEventListener('change', () => {
  if (!presetSel.value) return;
  applyPreset(presetSel.value, true);
});

function applyPreset(name, record) {
  const p = PRESETS[name];
  if (!p) return;
  if (record) pushUndo();

  TRACKS.forEach((track) => {
    const s = p[track.id] || '................';
    pattern[track.id].fill(0);
    for (let i = 0; i < state.length; i++) {
      const ch = s[i % 16];
      pattern[track.id][i] = ch === 'X' ? 2 : ch === 'x' ? 1 : 0;
    }
  });

  if (p.bpm) setBpm(p.bpm);
  paintAll();
  scheduleSave();
}

function clearAll() {
  pushUndo();
  TRACKS.forEach((t) => pattern[t.id].fill(0));
  paintAll();
  scheduleSave();
}

function randomize() {
  pushUndo();
  const r = Math.random;
  const L = state.length;

  TRACKS.forEach((t) => pattern[t.id].fill(0));

  // Kick: strong on 1, secondary on "3" (or 2.5 for 8-step)
  pattern.kick[0] = 2;
  if (L >= 16) {
    pattern.kick[8] = 1;
    if (r() < 0.5) pattern.kick[10] = 1;
  } else {
    pattern.kick[4] = 1;
  }
  for (let i = 1; i < L; i++) {
    if (i % 4 !== 0 && r() < 0.07) pattern.kick[i] = 1;
  }

  // Snare on 2 & 4
  const backbeats = L >= 16 ? [4, 12] : [4];
  backbeats.forEach((i) => { pattern.snare[i] = 2; });
  for (let i = 0; i < L; i++) {
    if (!pattern.snare[i] && r() < 0.05) pattern.snare[i] = 1;  // ghosts
  }

  // Clap doubles the snare about half the time
  if (r() < 0.5) backbeats.forEach((i) => { pattern.clap[i] = 1; });

  // Hats on 8ths + sparse 16th ghosts
  for (let i = 0; i < L; i += 2) {
    if (r() < 0.82) pattern.hat[i] = i % 4 === 0 ? 2 : 1;
  }
  for (let i = 1; i < L; i += 2) {
    if (r() < 0.16) pattern.hat[i] = 1;
  }

  // Open hats on offbeats
  for (let i = 2; i < L; i += 4) {
    if (r() < 0.22) pattern.openhat[i] = 1;
  }

  // Occasional tom fill at the end
  if (L >= 16 && r() < 0.4) {
    pattern.tom[L - 1] = 2;
    if (r() < 0.5) pattern.tom[L - 2] = 1;
  }

  // Sparse percussion
  for (let i = 0; i < L; i++) {
    if (r() < 0.04) pattern.rim[i] = 1;
    if (r() < 0.03) pattern.cowbell[i] = 1;
  }

  paintAll();
  scheduleSave();
}

randBtn.addEventListener('click', randomize);
clearBtn.addEventListener('click', clearAll);

/* ============================================================
   PERSISTENCE (localStorage + slots + export/import)
   ============================================================ */
const LS_KEY = 'beatlab.v3';
let saveTimer = null;
let slots = {};

function snapshotData() {
  const pat = {};
  TRACKS.forEach((t) => { pat[t.id] = pattern[t.id].slice(); });
  return {
    bpm: state.bpm,
    swing: state.swing,
    volume: state.volume,
    length: state.length,
    pattern: pat,
    muted: [...muted],
    soloed: [...soloed],
  };
}

function applyData(d) {
  if (!d || typeof d !== 'object') return;

  if (typeof d.bpm === 'number') setBpm(d.bpm);

  if (typeof d.swing === 'number') {
    state.swing = clamp(d.swing, 0, 0.8);
    swingInput.value = Math.round(state.swing * 100);
    swingVal.textContent = swingInput.value;
  }

  if (typeof d.volume === 'number') {
    state.volume = clamp(d.volume, 0, 1);
    volInput.value = Math.round(state.volume * 100);
    volVal.textContent = volInput.value;
    if (master) master.gain.value = state.volume;
  }

  if ([8, 16, 32].includes(d.length)) {
    state.length = d.length;
    document.querySelectorAll('#lengthSeg button').forEach((b) => {
      b.classList.toggle('active', +b.dataset.len === d.length);
    });
  }

  TRACKS.forEach((t) => {
    pattern[t.id].fill(0);
    const arr = d.pattern && d.pattern[t.id];
    if (Array.isArray(arr)) {
      const n = Math.min(NUM_MAX, arr.length);
      for (let i = 0; i < n; i++) {
        const v = arr[i] | 0;
        pattern[t.id][i] = v > 2 ? 2 : v < 0 ? 0 : v;
      }
    }
  });

  muted.clear();
  (d.muted || []).forEach((id) => {
    if (TRACKS.some((t) => t.id === id)) muted.add(id);
  });

  soloed.clear();
  (d.soloed || []).forEach((id) => {
    if (TRACKS.some((t) => t.id === id)) soloed.add(id);
  });

  buildGrid();
  scheduleSave();
}

function scheduleSave() {
  clearTimeout(saveTimer);
  saveTimer = setTimeout(saveNow, 400);
}

function saveNow() {
  try {
    localStorage.setItem(LS_KEY, JSON.stringify({ current: snapshotData(), slots }));
  } catch (e) { /* storage full or blocked — ignore */ }
}

function loadFromLS() {
  try {
    const raw = localStorage.getItem(LS_KEY);
    if (!raw) return null;
    const obj = JSON.parse(raw);
    slots = obj.slots && typeof obj.slots === 'object' ? obj.slots : {};
    return obj.current || null;
  } catch (e) {
    slots = {};
    return null;
  }
}

/* ---------- Slots UI ---------- */
function renderSlots(selected) {
  slotSel.innerHTML = '';
  const opt = document.createElement('option');
  opt.value = '';
  opt.textContent = Object.keys(slots).length ? '— Load pattern —' : '— No saved patterns —';
  slotSel.appendChild(opt);

  Object.keys(slots).sort((a, b) => a.localeCompare(b)).forEach((name) => {
    const o = document.createElement('option');
    o.value = name;
    o.textContent = name;
    slotSel.appendChild(o);
  });

  if (selected) slotSel.value = selected;
}

slotSel.addEventListener('change', () => {
  const name = slotSel.value;
  if (!name || !slots[name]) return;
  pushUndo();
  applyData(slots[name]);
});

saveBtn.addEventListener('click', () => {
  const name = prompt('Name this pattern:', 'My Beat');
  if (!name) return;
  const clean = name.trim().slice(0, 60);
  if (!clean) return;
  slots[clean] = snapshotData();
  renderSlots(clean);
  saveNow();
});

delBtn.addEventListener('click', () => {
  const name = slotSel.value;
  if (!name || !slots[name]) return;
  if (!confirm(`Delete "${name}"?`)) return;
  delete slots[name];
  renderSlots();
  saveNow();
});

/* ---------- Export / Import ---------- */
exportBtn.addEventListener('click', () => {
  const blob = new Blob([JSON.stringify(snapshotData(), null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'beat-lab-pattern.json';
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
});

importBtn.addEventListener('click', () => importInput.click());

importInput.addEventListener('change', () => {
  const file = importInput.files && importInput.files[0];
  importInput.value = '';
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const d = JSON.parse(reader.result);
      pushUndo();
      applyData(d);
      presetSel.value = '';
    } catch (e) {
      alert('Could not read that file — expected a Beat Lab JSON export.');
    }
  };
  reader.readAsText(file);
});

/* ============================================================
   UNDO
   ============================================================ */
const undoStack = [];

function pushUndo() {
  try { undoStack.push(JSON.stringify(snapshotData())); } catch (e) {}
  if (undoStack.length > 50) undoStack.shift();
  undoBtn.disabled = undoStack.length === 0;
}

function undo() {
  const s = undoStack.pop();
  if (!s) return;
  try { applyData(JSON.parse(s)); } catch (e) {}
  undoBtn.disabled = undoStack.length === 0;
}

undoBtn.addEventListener('click', undo);

/* ============================================================
   KEYBOARD
   ============================================================ */
document.addEventListener('keydown', (e) => {
  const tag = (e.target && e.target.tagName) || '';
  if (['INPUT', 'SELECT', 'TEXTAREA', 'BUTTON'].includes(tag)) return;

  if (e.code === 'Space') {
    e.preventDefault();
    toggleTransport();
    return;
  }

  if (/^Digit[1-8]$/.test(e.code)) {
    const i = +e.code.slice(5) - 1;
    const track = TRACKS[i];
    if (!track) return;
    e.shiftKey ? toggleSolo(track.id) : toggleMute(track.id);
    return;
  }

  if (e.key === 'r' || e.key === 'R') {
    randomize();
  }
});

/* Auto-resume / create audio context on the first interaction */
document.addEventListener('pointerdown', ensureAudio, { passive: true });
document.addEventListener('keydown', ensureAudio);

/* ============================================================
   BOOT
   ============================================================ */
const saved = loadFromLS();
renderSlots();
buildGrid();

if (saved) {
  applyData(saved);
  presetSel.value = '';
} else {
  applyPreset('Boom Bap', false);
  presetSel.value = 'Boom Bap';
}
</script>
</body>
</html>
